---
import { getLangFromUrl } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
---

<div class="inline-flex items-center gap-1 rounded-xl border border-white/10 bg-zinc-900/80 p-1 backdrop-blur-md font-mono text-xs">
  <a 
    href="/" 
    class={`px-2.5 py-1 rounded-lg transition-all duration-200 ${
      currentLang === 'en' 
        ? 'bg-lime-500/20 text-lime-400 font-bold border border-lime-500/30 shadow-[0_0_10px_rgba(132,204,22,0.15)]' 
        : 'text-zinc-400 hover:text-white hover:bg-zinc-800/50'
    }`}
  >
    EN
  </a>
  
  <span class="text-zinc-700 select-none">|</span>
  
  <a 
    href="/es" 
    class={`px-2.5 py-1 rounded-lg transition-all duration-200 ${
      currentLang === 'es' 
        ? 'bg-lime-500/20 text-lime-400 font-bold border border-lime-500/30 shadow-[0_0_10px_rgba(132,204,22,0.15)]' 
        : 'text-zinc-400 hover:text-white hover:bg-zinc-800/50'
    }`}
  >
    ES
  </a>
</div>