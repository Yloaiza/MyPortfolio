---
// Stack.astro
---

<section class="container mx-auto py-20 px-4 sm:px-6 lg:px-8">
  <!-- Encabezado -->
  <div class="text-center mb-16">
    <h1 class="text-white text-4xl sm:text-5xl font-extrabold tracking-tight mt-2" data-i18n="stack.title">My Stack</h1>
  </div>

  <!-- Contenedor del Carousel Infinito -->
  <div class="w-full inline-flex flex-nowrap overflow-hidden py-6 [mask-image:_linear-gradient(to_right,transparent_0,_black_128px,_black_calc(100%-128px),transparent_100%)]">
    
    <!-- Lista Original -->
    <ul class="flex items-center justify-center md:justify-start [&_li]:mx-8 animate-infinite-scroll shrink-0">
      <li>
        <div class="group flex flex-col items-center justify-center cursor-pointer">
          <img class="h-16 w-16 object-contain grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-300" src="/react.png" alt="React" />
          <span class="text-xs font-semibold text-slate-500 mt-3 group-hover:text-lime-400 transition-colors duration-300">React</span>
        </div>
      </li>
      <li>
        <div class="group flex flex-col items-center justify-center cursor-pointer">
          <img class="h-16 w-16 object-contain grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-300" src="./angular.png" alt="Angular" />
          <span class="text-xs font-semibold text-slate-500 mt-3 group-hover:text-lime-400 transition-colors duration-300">Angular</span>
        </div>
      </li>
      <li>
        <div class="group flex flex-col items-center justify-center cursor-pointer">
