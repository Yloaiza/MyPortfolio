---
// Contact.astro
---

<section id="contact" class="relative py-24 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto flex flex-col items-center">
  <!-- Tarjeta 3D con haz de luz sweep, spotlight y bordes tácticos -->
  <div 
    id="tilt-card"
    class="group relative w-full overflow-hidden rounded-3xl border border-white/10 bg-zinc-950/90 p-8 sm:p-12 backdrop-blur-2xl shadow-2xl transition-all duration-300 ease-out hover:border-lime-500/40"
    style="transform-style: preserve-3d;"
  >
    <!-- BANDA DE LUZ SWEEP (Pasa de izquierda a derecha al hacer Hover) -->
    <div class="pointer-events-none absolute inset-0 z-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
      <div class="absolute -top-[50%] -bottom-[50%] w-1/2 bg-gradient-to-r from-transparent via-lime-400/15 to-transparent -rotate-45 -translate-x-[200%] group-hover:translate-x-[350%] transition-transform duration-1000 ease-in-out"></div>
    </div>

    <!-- Esquinas decorativas tácticas (Corner TL y BR) -->
    <span class="absolute top-4 left-4 h-3 w-3 border-t-2 border-l-2 border-lime-500/60 z-10 transition-all duration-300 group-hover:-translate-x-1 group-hover:-translate-y-1 group-hover:border-lime-400"></span>
    <span class="absolute bottom-4 right-4 h-3 w-3 border-b-2 border-r-2 border-lime-500/60 z-10 transition-all duration-300 group-hover:translate-x-1 group-hover:translate-y-1 group-hover:border-lime-400"></span>

    <!-- Efecto de brillo radial (Spotlight) que persigue al mouse -->
    <div 
      id="spotlight"
      class="pointer-events-none absolute -inset-px opacity-0 transition-opacity duration-300 rounded-3xl z-0"
      style="background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(132, 204, 22, 0.12), transparent 40%);"
    ></div>

    <div class="relative z-10 flex flex-col items-center text-center">
      <!-- 1. Availability Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-lime-500/20 bg-lime-500/10 px-3.5 py-1 text-xs font-mono font-medium text-lime-400 mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-lime-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-lime-500"></span>
        </span>
        <span data-i18n="contact.availability">AVAILABILITY</span>
      </div>

      <!-- 2. Main Title -->
      <h2 id="contact-title" class="text-3xl sm:text-5xl font-serif font-medium tracking-tight text-white max-w-2xl leading-tight mb-4" data-i18n="contact.title">
        Looking for someone who can design, build and ship?
      </h2>

      <!-- 3. Subtitle / Description -->
      <p class="text-base sm:text-lg text-zinc-400 max-w-xl mb-8 leading-relaxed" data-i18n="contact.subtitle">
        I'm open to remote Full-Stack & Mobile roles, contractor work, and MVP/product builds across LATAM and global teams.
      </p>

      <!-- 4. Primary Actions -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-10 w-full sm:w-auto">
        <a 
          href="mailto:loaizaagudeloy@gmail.com" 
          class="flex items-center justify-center gap-2 rounded-xl bg-lime-500 px-5 py-3 text-sm font-semibold text-black transition-all duration-300 hover:bg-lime-400 hover:scale-105 shadow-[0_0_20px_rgba(132,204,22,0.3)]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>
          <span data-i18n="contact.btn.email">Email me</span>
        </a>

        <a 
          href="/YojanLoaizaagudelo_CV.pdf"
          target="_blank" 
          rel="noreferrer"
          class="flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-zinc-900 px-5 py-3 text-sm font-semibold text-white transition-all duration-300 hover:border-lime-500/50 hover:bg-zinc-800 hover:scale-105"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"></path><path d="M14 2v5a1 1 0 0 0 1 1h5"></path><path d="M12 18v-6"></path><path d="m9 15 3 3 3-3"></path></svg>
          <span data-i18n="contact.btn.resume">View resume</span>
        </a>

        <a 
          href="https://www.linkedin.com/in/yojan-arbey-loaiza-dev/" 
          target="_blank" 
          rel="noreferrer"
          class="flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-zinc-900 px-5 py-3 text-sm font-semibold text-white transition-all duration-300 hover:border-lime-500/50 hover:bg-zinc-800 hover:scale-105"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-lime-400"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          <span data-i18n="contact.btn.linkedin">Connect on LinkedIn</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>

      <!-- 5. Formspree Quick Form Section -->
      <form
        action="https://formspree.io/f/movarpqe"
        method="POST"
        class="w-full max-w-lg space-y-4 mb-10 text-left bg-zinc-900/50 p-6 rounded-2xl border border-white/5"
      >
        <p class="text-xs font-mono uppercase tracking-wider text-lime-400 mb-2" data-i18n="contact.form.label">// Or leave a quick message</p>
        <input
          type="email"
          name="email"
          placeholder="Your email address"
          data-i18n-placeholder="contact.form.email"
          class="w-full px-4 py-2.5 bg-zinc-950 border border-white/10 rounded-xl text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-lime-500 transition-colors"
          required
        />
        <textarea
          name="message"
          rows="3"
          placeholder="Your message..."
          data-i18n-placeholder="contact.form.message"
          class="w-full px-4 py-2.5 bg-zinc-950 border border-white/10 rounded-xl text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-lime-500 transition-colors resize-none"
          required
        ></textarea>
        <button
          type="submit"
          class="w-full bg-zinc-800 hover:bg-lime-500 hover:text-black text-white text-xs font-mono font-semibold py-2.5 rounded-xl border border-white/10 hover:border-lime-500 transition-all duration-300"
          data-i18n="contact.form.submit"
        >
          Send Message
        </button>
      </form>

      <!-- 6. Chips / Roles Categories -->
      <div class="w-full pt-6 border-t border-white/10">
        <p class="text-xs font-mono uppercase tracking-widest text-zinc-500 mb-4" data-i18n="contact.looking.for">LOOKING FOR</p>
        <div class="flex flex-wrap justify-center gap-2">
          <span class="rounded-full border border-white/10 bg-zinc-900/80 px-3.5 py-1.5 text-xs text-zinc-300 hover:border-lime-500/40 hover:text-white transition-colors" data-i18n="chip.1">Software Engineer roles</span>
          <span class="rounded-full border border-white/10 bg-zinc-900/80 px-3.5 py-1.5 text-xs text-zinc-300 hover:border-lime-500/40 hover:text-white transition-colors" data-i18n="chip.2">Mobile Developer (React Native / Expo)</span>
          <span class="rounded-full border border-white/10 bg-zinc-900/80 px-3.5 py-1.5 text-xs text-zinc-300 hover:border-lime-500/40 hover:text-white transition-colors" data-i18n="chip.3">Full-Stack Engineer</span>
          <span class="rounded-full border border-white/10 bg-zinc-900/80 px-3.5 py-1.5 text-xs text-zinc-300 hover:border-lime-500/40 hover:text-white transition-colors" data-i18n="chip.4">Startup MVP builds</span>
          <span class="rounded-full border border-white/10 bg-zinc-900/80 px-3.5 py-1.5 text-xs text-zinc-300 hover:border-lime-500/40 hover:text-white transition-colors" data-i18n="chip.5">AI-assisted product features</span>
          <span class="rounded-full border border-white/10 bg-zinc-900/80 px-3.5 py-1.5 text-xs text-zinc-300 hover:border-lime-500/40 hover:text-white transition-colors" data-i18n="chip.6">Spring Boot / Backend systems</span>
        </div>
      </div>

      <!-- 7. Direct Email Line -->
      <p class="mt-8 text-xs font-mono text-zinc-500">
        <span data-i18n="contact.direct">Direct line:</span> <a href="mailto:loaizaagudeloy@gmail.com" class="text-lime-400 underline decoration-lime-500/30 underline-offset-4 hover:decoration-lime-400 transition-colors">loaizaagudeloy@gmail.com</a>
      </p>
    </div>
  </div>
</section>

<script>
  const setupContactCard = () => {
    const card = document.getElementById('tilt-card');
    const spotlight = document.getElementById('spotlight');

    if (card && spotlight) {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
        spotlight.style.opacity = '1';

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -5; 
        const rotateY = ((x - centerX) / centerX) * 5;  

        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.01, 1.01, 1.01)`;
      });

      card.addEventListener('mouseleave', () => {
        spotlight.style.opacity = '0';
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      });
    }
  };

  setupContactCard();
  document.addEventListener('astro:page-load', setupContactCard);
</script>